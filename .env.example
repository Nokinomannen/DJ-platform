# Local SQLite file. For production, point at a hosted libSQL/Turso database.
DATABASE_URL=file:data/gigga.db
# DATABASE_AUTH_TOKEN=

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded audio and photos are stored (local disk in dev).
UPLOAD_DIR=data/uploads
